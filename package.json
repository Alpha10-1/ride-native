{
  "name": "ride-native",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "rider": "npm run start -w @ride/rider-app",
    "driver": "npm run start -w @ride/driver-app",
    "rider:android": "npm run android -w @ride/rider-app",
    "driver:android": "npm run android -w @ride/driver-app",
    "rider:ios": "npm run ios -w @ride/rider-app",
    "driver:ios": "npm run ios -w @ride/driver-app",
    "typecheck": "npm run typecheck -w @ride/rider-app && npm run typecheck -w @ride/driver-app"
  },
  "devDependencies": {
    "supabase": "^2.109.1",
    "typescript": "~5.9.2"
  }
}
